<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Visual Bookmarks</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f2f4f8;
}

h1 {
  text-align: center;
  padding: 20px;
  margin: 0;
  background: #1f2937;
  color: white;
}

.bookmarks {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 20px;
  padding: 30px;
}

.bookmark {
  background: white;
  text-align: center;
  padding: 20px;
  border-radius: 14px;
  text-decoration: none;
  color: #111;
  box-shadow: 0 4px 8px rgba(0,0,0,0.15);
  transition: transform 0.2s, box-shadow 0.2s;
}

.bookmark:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 16px rgba(0,0,0,0.25);
}

.bookmark img {
  width: 70px;
  height: 70px;
  object-fit: contain;
}

.bookmark p {
  margin-top: 10px;
  font-weight: bold;
}
</style>
</head>

<body>

<h1>My Visual Bookmarks</h1>

<div class="bookmarks">

  <a class="bookmark" href="https://www.google.com">
    <img src="https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg">
    <p>Google</p>
  </a>

  <a class="bookmark" href="https://www.youtube.com">
    <img src="https://upload.wikimedia.org/wikipedia/commons/b/b8/YouTube_Logo_2017.svg">
    <p>YouTube</p>
  </a>

  <a class="bookmark" href="https://mail.google.com">
    <img src="https://upload.wikimedia.org/wikipedia/commons/4/4e/Gmail_Icon.png">
    <p>Gmail</p>
  </a>

  <a class="bookmark" href="https://www.wikipedia.org">
    <img src="https://upload.wikimedia.org/wikipedia/commons/6/63/Wikipedia-logo.png">
    <p>Wikipedia</p>
  </a>

  <a class="bookmark" href="https://chat.openai.com">
    <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg">
    <p>ChatGPT</p>
  </a>

</div>

</body>
</html>
